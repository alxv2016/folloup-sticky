# ESP-IDF generated files
# sdkconfig is regenerated from sdkconfig.defaults on every build, and menuconfig writes
# real values into it -- including secrets like CONFIG_FOLLOWUP_GEMINI_API_KEY. Keep it
# untracked so credentials cannot reach a commit; sdkconfig.defaults is the tracked one.
sdkconfig
sdkconfig.old
*.map
flasher_args.json
flash_project_args
project_description.json
size.json
bootloader-flash_args
partition-table-flash_args

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile
install_manifest.txt
compile_commands.json

# Temporary files
*.tmp
*.log
*.bak
*.swp

# vcpkg
vcpkg_installed/

# debug information files
*.dwo

# test output & cache
Testing/
.cache/

# Python bytecode cache
__pycache__/
*.pyc
